# Copy this file to `.env` next to compose.deploy.yaml and replace the
# placeholders. Never commit the real .env.

# Image tag to run: `latest`, or a fixed build such as sha-ae4a917.
API_TAG=latest
# Port on this computer that reaches the API.
API_PORT=3000

POSTGRES_USER=perf
POSTGRES_PASSWORD=change-me-letters-and-digits-only
POSTGRES_DB=perf
# Same user, password and database as above. The host name stays `db`.
DATABASE_URL=postgres://perf:change-me-letters-and-digits-only@db:5432/perf
# The bundled Postgres has no SSL. Remove this line for a hosted database.
DB_SSL=false

JWT_SECRET=change-me-long-random-value
# Needed only for GET /metrics/analyze.
GOOGLE_API_KEY=
# Comma-separated browser origins allowed to call the API. Empty uses the defaults.
CORS_ORIGINS=
